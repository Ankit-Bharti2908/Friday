# ============================================================================
# Friday — environment template.  Copy to .env and fill in.   cp .env.example .env
# Secrets live ONLY here. JSON configs reference these as ${VAR}. Never commit .env.
# ============================================================================

# --- Telegram (PRIMARY channel — required to run main.py) -------------------
# Bot token from @BotFather. Your numeric id from @userinfobot (the allowlist —
# the bot answers nobody else).
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# --- LLM providers (cloud keys are OPTIONAL — Friday runs fully local) -------
# Tiers in config/models.json are tried in order; missing-key models are skipped.
# Set any of these only if you want cloud fallbacks behind the local models.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Local backends need NO key:
#   • llama.cpp (Gemma 3n E4B, the local-first primary) — `scripts/llamacpp.sh` on :8080
#   • Ollama (fallback)                                 — `ollama serve` on :11434

# --- Core settings ----------------------------------------------------------
FRIDAY_TZ=Asia/Kolkata
# Daily workout alert from the gym agent ("HH:MM" 24h in FRIDAY_TZ; empty = off).
# Fires urgent (bypasses quiet hours) — it's an alarm you set on purpose.
FRIDAY_WORKOUT_ALERT=06:30
# Daily diet alert (same format). Sends today's saved meal plan; stays silent on
# days without one, so leaving it on costs nothing.
FRIDAY_DIET_ALERT=07:00
# Sandbox/filesystem-MCP root (auto-created). ${FRIDAY_WORKSPACE} resolves in mcp.json.
FRIDAY_WORKSPACE=~/friday-workspace
# Phoenix tracing: 1 = on (run `uv run phoenix serve`), 0 = off.
FRIDAY_TRACING=1

# --- GitHub MCP (optional) — enable _github_remote in config/mcp.json --------
# A fine-grained PAT; the hosted GitHub MCP authenticates with it.
GITHUB_TOKEN=

# --- Google Workspace MCP (optional) — enable _google_workspace in mcp.json --
# OAuth client from Google Cloud Console (Gmail + Calendar scopes).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- WhatsApp (optional, SECONDARY — ToS/ban risk, use a spare number) -------
# Start the Node bridge first (cd bridge/whatsapp && npm install && npm start).
WHATSAPP_ENABLED=0
# Your own JID, e.g. 9198xxxxxxxx@s.whatsapp.net
WHATSAPP_OWNER_JID=
WHATSAPP_WS_URL=ws://127.0.0.1:8765
# Port the Node bridge listens on (must match WHATSAPP_WS_URL). Bridge-side only.
# BRIDGE_PORT=8765
